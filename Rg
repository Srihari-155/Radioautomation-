public boolean loginToRadiology(
        String username,
        String password) throws Exception {

    try {

        WebElement usernameTextbox =
                commonEvents.findElement(
                        getUsernameTextfieldLocator);

        commonEvents.highlight(usernameTextbox);
        commonEvents.sendKeys(
                usernameTextbox,
                username);

        WebElement passwordTextbox =
                commonEvents.findElement(
                        getPasswordTextboxLocator);

        commonEvents.highlight(passwordTextbox);
        commonEvents.sendKeys(
                passwordTextbox,
                password);

        WebElement signInButton =
                commonEvents.findElement(
                        getSignInButtonLocator);

        commonEvents.highlight(signInButton);
        commonEvents.click(signInButton);

        Thread.sleep(2000);

        WebElement radiologyModule =
                commonEvents.findElement(
                        getRadiologyLocator);

        commonEvents.highlight(radiologyModule);

        return commonEvents.isDisplayed(radiologyModule);

    } catch (Exception e) {

        throw e;
    }
}



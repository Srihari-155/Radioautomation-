public boolean verifyDatesAreRememberedCorrectly(
        String fromDate,
        String toDate) throws Exception {

    try {

        String[] fromDateComponents =
                fromDate.split("-");

        String fromDay =
                fromDateComponents[0];

        String fromMonth =
                fromDateComponents[1];

        String fromYear =
                fromDateComponents[2];

        String[] toDateComponents =
                toDate.split("-");

        String toDay =
                toDateComponents[0];

        String toMonth =
                toDateComponents[1];

        String toYear =
                toDateComponents[2];

        WebElement fromDateDropdown =
                commonEvents.findElement(
                        calendarFromDropdown);

        WebElement toDateDropdown =
                commonEvents.findElement(
                        calendarToDropdown);

        WebElement okButton =
                commonEvents.findElement(
                        getOkButtonLocator);

        commonEvents.highlight(fromDateDropdown);

        commonEvents.sendKeys(
                fromDateDropdown,
                fromDay);

        commonEvents.sendKeys(
                fromDateDropdown,
                fromMonth);

        commonEvents.sendKeys(
                fromDateDropdown,
                fromYear);

        commonEvents.highlight(toDateDropdown);

        commonEvents.sendKeys(
                toDateDropdown,
                toDay);

        commonEvents.sendKeys(
                toDateDropdown,
                toMonth);

        commonEvents.sendKeys(
                toDateDropdown,
                toYear);

        WebElement toolTip =
                commonEvents.findElement(
                        getStarIconLocator);

        commonEvents.click(toolTip);

        commonEvents.highlight(okButton);

        commonEvents.click(okButton);

        commonEvents.click(
                getPageBarFixedLocatorWardBilling);

        commonEvents.click(
                getPageBarFixedLocatorListRequests);

        commonEvents.waitTillElementVisible(
                getOkButtonLocator,
                10000);

        String actualFromDate =
                fromDay + "-"
                        + fromMonth + "-"
                        + fromYear;

        String actualToDate =
                toDay + "-"
                        + toMonth + "-"
                        + toYear;

        if (actualFromDate.equals(fromDate)
                &&
                actualToDate.equals(toDate)) {

            return true;
        }

    } catch (Exception e) {

        throw e;
    }

    return false;
}


